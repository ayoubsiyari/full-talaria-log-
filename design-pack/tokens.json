{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Talaria Obsidian Chrome",
  "version": "1.0.0",
  "description": "Static design tokens for Plan 4 Phase 1 chart chrome skin. Apply once at theme switch — never per frame.",
  "meta": {
    "prefix": "--talaria-",
    "themes": ["dark", "light", "light-soft"],
    "apply": "Set data-talaria-theme on the shell root once. Do not write these vars in rAF/mousemove."
  },
  "brand": {
    "black": "#000000",
    "white": "#ffffff",
    "blue": "#3090ff",
    "blueDeep": "#232cf4",
    "slate": "#2c537a",
    "lilac": "#a2a1cd",
    "mist": "#ebe9fe"
  },
  "typography": {
    "fontUi": "\"Helvetica Now\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontDisplay": "\"Blauer Nue\", \"Exo 2\", \"Helvetica Neue\", sans-serif",
    "fontMono": "\"JetBrains Mono\", ui-monospace, monospace",
    "sizeXs": "10px",
    "sizeSm": "11px",
    "sizeMd": "12px",
    "sizeBase": "13px",
    "sizeLg": "14px",
    "weightRegular": 500,
    "weightSemi": 600,
    "weightBold": 700,
    "labelTracking": "0.04em"
  },
  "spacing": {
    "intra": "4px",
    "inter": "12px",
    "padPanel": "14px",
    "topbarH": "48px",
    "railW": "48px",
    "replaybarH": "48px",
    "tabstripH": "36px",
    "orderRailW": "320px",
    "iconGlyph": "18px",
    "iconHit": "36px",
    "iconHitTouch": "44px"
  },
  "radius": {
    "control": "6px",
    "panel": "8px",
    "cta": "6px",
    "window": "8px",
    "pill": "999px"
  },
  "motion": {
    "control": "140ms ease-out",
    "menu": "160ms ease-out"
  },
  "z": {
    "rail": 30,
    "topbarDrop": 9000,
    "modal": 9002,
    "tip": 99999
  },
  "themes": {
    "dark": {
      "bg": "#000000",
      "surface": "#0a0a0b",
      "surfaceRaised": "#141416",
      "surfaceSunken": "#050505",
      "line": "color-mix(in oklab, #a2a1cd 22%, transparent)",
      "lineStrong": "color-mix(in oklab, #a2a1cd 42%, transparent)",
      "text": "#f4f4f5",
      "textMuted": "color-mix(in oklab, #f4f4f5 64%, #a2a1cd)",
      "textFaint": "color-mix(in oklab, #f4f4f5 40%, #a2a1cd)",
      "accent": "#3090ff",
      "accentHover": "#4aa0ff",
      "accentDeep": "#232cf4",
      "accentQuiet": "color-mix(in oklab, #3090ff 16%, transparent)",
      "up": "oklch(0.72 0.14 155)",
      "down": "oklch(0.63 0.18 25)",
      "warn": "oklch(0.78 0.14 85)",
      "ctaBg": "#ffffff",
      "ctaFg": "#000000",
      "ctaHover": "#ebe9fe",
      "overlay": "color-mix(in oklab, #000 55%, transparent)",
      "colorScheme": "dark"
    },
    "light": {
      "bg": "#e4e6f0",
      "surface": "#eceef6",
      "surfaceRaised": "#f3f4f9",
      "surfaceSunken": "#dde0ec",
      "line": "color-mix(in oklab, #2c537a 22%, transparent)",
      "lineStrong": "color-mix(in oklab, #2c537a 40%, transparent)",
      "text": "#12141a",
      "textMuted": "color-mix(in oklab, #12141a 58%, #2c537a)",
      "textFaint": "color-mix(in oklab, #12141a 40%, #2c537a)",
      "accent": "#1f6fd4",
      "accentHover": "#2a7de8",
      "accentDeep": "#232cf4",
      "accentQuiet": "color-mix(in oklab, #3090ff 12%, transparent)",
      "up": "oklch(0.48 0.12 155)",
      "down": "oklch(0.50 0.16 25)",
      "warn": "oklch(0.55 0.12 85)",
      "ctaBg": "#000000",
      "ctaFg": "#ffffff",
      "ctaHover": "#22242a",
      "overlay": "color-mix(in oklab, #12141a 32%, transparent)",
      "colorScheme": "light"
    },
    "light-soft": {
      "bg": "#dde0e6",
      "surface": "#e6e8ed",
      "surfaceRaised": "#eef0f3",
      "surfaceSunken": "#d2d5dc",
      "line": "color-mix(in oklab, #2c537a 20%, transparent)",
      "lineStrong": "color-mix(in oklab, #2c537a 36%, transparent)",
      "text": "#12141a",
      "textMuted": "color-mix(in oklab, #12141a 56%, #2c537a)",
      "textFaint": "color-mix(in oklab, #12141a 38%, #2c537a)",
      "accent": "#1f6fd4",
      "accentHover": "#2a7de8",
      "accentDeep": "#232cf4",
      "accentQuiet": "color-mix(in oklab, #3090ff 11%, transparent)",
      "up": "oklch(0.48 0.12 155)",
      "down": "oklch(0.50 0.16 25)",
      "warn": "oklch(0.55 0.12 85)",
      "ctaBg": "#000000",
      "ctaFg": "#ffffff",
      "ctaHover": "#22242a",
      "overlay": "color-mix(in oklab, #12141a 28%, transparent)",
      "colorScheme": "light"
    }
  },
  "slots": {
    "SK-01": "Theme tokens — apply data-talaria-theme once",
    "SK-02": "App frame + chart viewport host",
    "SK-03": "Top toolbar (symbol, chart type, indicators, TF, place order, utils)",
    "SK-04": "Left tool rail + bottom replay / trades strip",
    "SK-05": "Control states + shared icon sprite"
  }
}
