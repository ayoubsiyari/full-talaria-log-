{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": "./homepage",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["homepage/**/*.ts", "homepage/**/*.tsx"],
  "exclude": ["homepage/node_modules", "homepage/.next"]
}
