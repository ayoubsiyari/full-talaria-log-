{
  "name": "talaria-workspace",
  "private": true,
  "description": "Root convenience scripts; V9 live UI is built only from chart v 1.4/talaria-design (npm run build:chart-v9).",
  "scripts": {
    "build:chart-v9": "npm run build:live --prefix \"chart v 1.4/talaria-design\"",
    "sync:chart-v9": "node \"chart v 1.4/talaria-design/scripts/sync-v9-to-homepage.mjs\"",
    "dev:chart-v9": "npm run dev:live --prefix \"chart v 1.4/talaria-design\"",
    "build:homepage": "npm run build --prefix homepage",
    "build:web": "npm run build:chart-v9 && npm run build:homepage",
    "docker:build-chart": "docker compose build trading-chart",
    "docker:up-chart": "docker compose up -d --build trading-chart"
  },
  "dependencies": {
    "dukascopy-node": "^1.46.3",
    "framer-motion": "^12.38.0"
  }
}
