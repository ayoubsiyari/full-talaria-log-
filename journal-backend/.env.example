# ============================================================
# Talaria Journal Backend — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/talaria

# ─── Flask / JWT ─────────────────────────────────────────────
# Required in production: long random values (32+ chars), not placeholders
SECRET_KEY=
JWT_SECRET_KEY=change-me-to-a-random-64-char-string

# ─── Stripe (Subscriptions & Payments) ───────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get this from https://dashboard.stripe.com/webhooks (create endpoint for /journal/api/subscriptions/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Frontend URL (for checkout / portal redirects) ──────────
FRONTEND_URL=https://yourdomain.com
# Optional: extra allowed origins for Stripe success/cancel/return URLs (comma-separated)
# STRIPE_REDIRECT_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com
# In production, HTTP redirect URLs are rejected unless you use HTTP-only staging:
# STRIPE_REDIRECT_REQUIRE_HTTPS=false

# ─── Email (optional) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ─── Security ────────────────────────────────────────────────
# Production refuses weak secrets and non-Postgres DB unless this is set (emergency only)
# DISABLE_PROD_SECURITY_CHECK=0
# Max failed login attempts before IP auto-block
MAX_FAILED_ATTEMPTS=10
# Duration (hours) to block an IP after max failed attempts
BLOCK_DURATION_HOURS=24
# Failed attempt counting window (hours)
FAILED_ATTEMPT_WINDOW_HOURS=1

# ─── Chart replay: forex news (optional) ─────────────────────
# Finnhub API key — forex market news for /api/chart/replay-news (server-side only).
# https://finnhub.io/register
# FINNHUB_API_KEY=
