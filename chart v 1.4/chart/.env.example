# Trading chart API (FastAPI) — place this file as `.env` in THIS directory (next to api_server.py).
#
#   FINNHUB_API_KEY=your_finnhub_token
#
# Used for /api/finnhub/* proxies (economic calendar, forex news sidebar + replay news).
# Economic calendar requires Finnhub Economic-1 ($50/mo) — https://finnhub.io/pricing-economic-data-api
# The key never goes to the browser.
#
# Docker (repo root): `docker compose` loads this file into the trading-chart service (see docker-compose.yml).
# After changing, restart: docker compose up -d trading-chart
#
# https://finnhub.io/register

FINNHUB_API_KEY=

# ── Stripe billing portal / checkout return URLs (api_server `_chart_stripe_return_origins`) ──
# Set FRONTEND_URL to the **origin** of the Next homepage users open in the browser (scheme + host + port, no path).
# Until www.talaria-log.com is live, use whatever you actually use locally, e.g.:
#   FRONTEND_URL=http://localhost:3000
# When production is on the www host:
#   FRONTEND_URL=https://www.talaria-log.com
# If you also serve the apex or previews, list every origin (comma-separated, no paths):
#   STRIPE_REDIRECT_ALLOWED_ORIGINS=https://www.talaria-log.com,https://talaria-log.com,https://preview.vercel.app
# You can set these in a repo-root `.env` for `docker compose` (see docker-compose.yml `trading-chart`) or here.

# FRONTEND_URL=http://localhost:3000
# STRIPE_REDIRECT_ALLOWED_ORIGINS=

# ── Deploy / CPU (docker-compose defaults SKIP_BINARY_BACKFILL_ON_STARTUP=true) ──
# NEVER set AUTH_ENABLED=false here for production — that exposes anonymous@local admin to everyone.
# Worker container sets AUTH_ENABLED=false in docker-compose.yml; API (trading-chart) must stay true.
# When true, restarting trading-chart does NOT scan every dataset and queue binary/tile rebuilds.
# Set false for a one-time full repair pass, or rebuild individual datasets from admin → Datasets → Rebuild binary.
# SKIP_BINARY_BACKFILL_ON_STARTUP=true
# BACKTEST_WHATIF_DRAIN_ON_API=false
# WEB_CONCURRENCY=2
# Default 2 on 16GB VPS — pair with Redis bar cache (BACKTEST_BARS_CACHE_*).
# Raise to 3–4 only with 32GB+ RAM; avoid 4 workers × mmap duplication on one box.
# For horizontal scale: run multiple trading-chart replicas behind a load balancer
# instead of raising workers per container.
WEB_CONCURRENCY=2
# Shared Redis cache for identical /bars and /smart windows (all gunicorn workers + panels).
# Requires REDIS_URL (set automatically in docker-compose.yml).
# BACKTEST_BARS_CACHE_ENABLED=true
# BACKTEST_BARS_CACHE_TTL_SEC=300
# BACKTEST_BARS_CACHE_MAX_BYTES=8000000
# FIrstrate_SCHEDULE_TICK_SEC=120

# Entitlements resolver reads active subscription plan caps at runtime (when db session available).
# Set false only for emergency rollback to legacy user-column limits.
# ENTITLEMENTS_RESOLVER_V2=true

# ── Security Monitor (admin dashboard → "Security monitor") ──
# All optional; safe defaults shown. This subsystem is low-cost: the per-request
# check is an in-memory dict lookup (the blocklist is refreshed from the DB at most
# once per SECURITY_BLOCKLIST_TTL_SEC), and rows are only WRITTEN on actual security
# events (failed logins, 429s, 403s, scans, blocks) — normal 2xx traffic writes nothing.
#
# Auto-block: after THRESHOLD failed auths from one IP within WINDOW seconds, block it
# for HOURS. Set THRESHOLD=0 to disable auto-blocking. Your own IP + private ranges are
# never blocked (self-lockout protection); add office/VPN IPs to SECURITY_IP_ALLOWLIST.
# SECURITY_AUTOBLOCK_THRESHOLD=12
# SECURITY_AUTOBLOCK_WINDOW_SEC=900
# SECURITY_AUTOBLOCK_HOURS=6
# SECURITY_BLOCKLIST_TTL_SEC=15
# SECURITY_IP_ALLOWLIST=203.0.113.10,203.0.113.11
#
# ── ALERTS: how you get told when you're not watching the dashboard ──────────
# Set at least SECURITY_ALERT_EMAIL to receive:
#   1. Critical events (an IP getting auto-blocked).
#   2. Attack "spikes" — a burst of suspicious events in a short window (brute
#      force / scan storm), even if nothing hit the auto-block threshold yet.
#   3. Service start/crash — the API emails on every startup; since containers
#      auto-restart, an unexpected startup email means it crashed and recovered.
# Email reuses the SMTP_* / DOMAIN_EMAIL_* config below (must be set for email to send).
# Slack webhook host is pinned to hooks.slack.com (SSRF-safe). Throttled per event key.
# SECURITY_ALERT_EMAIL=you@talaria-log.com
# SECURITY_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SECURITY_ALERT_THROTTLE_SEC=300
# Spike alert tuning: fire when >= THRESHOLD non-info events occur within WINDOW seconds.
# SECURITY_SPIKE_THRESHOLD=25
# SECURITY_SPIKE_WINDOW_SEC=120
#
# Optional country enrichment: point at a local MaxMind GeoLite2-Country.mmdb.
# Left unset => country column stays blank (NO external calls are ever made).
# GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb
