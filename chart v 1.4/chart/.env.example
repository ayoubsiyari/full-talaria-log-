# Trading chart API (FastAPI) — place this file as `.env` in THIS directory (next to api_server.py).
#
#   FINNHUB_API_KEY=your_finnhub_token
#
# Used for /api/finnhub/* proxies (News sidebar + replay news). The key never goes to the browser.
#
# Docker (repo root): `docker compose` loads this file into the trading-chart service (see docker-compose.yml).
# After changing, restart: docker compose up -d trading-chart
#
# https://finnhub.io/register

FINNHUB_API_KEY=
