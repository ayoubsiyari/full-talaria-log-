# Trading chart API (FastAPI) — place this file as `.env` in THIS directory (next to api_server.py).
#
#   FINNHUB_API_KEY=your_finnhub_token
#
# Used for /api/finnhub/* proxies (News sidebar + replay news). The key never goes to the browser.
#
# Docker (repo root): `docker compose` loads this file into the trading-chart service (see docker-compose.yml).
# After changing, restart: docker compose up -d trading-chart
#
# https://finnhub.io/register

FINNHUB_API_KEY=

# ── Stripe billing portal / checkout return URLs (api_server `_chart_stripe_return_origins`) ──
# Set FRONTEND_URL to the **origin** of the Next homepage users open in the browser (scheme + host + port, no path).
# Until www.talaria-log.com is live, use whatever you actually use locally, e.g.:
#   FRONTEND_URL=http://localhost:3000
# When production is on the www host:
#   FRONTEND_URL=https://www.talaria-log.com
# If you also serve the apex or previews, list every origin (comma-separated, no paths):
#   STRIPE_REDIRECT_ALLOWED_ORIGINS=https://www.talaria-log.com,https://talaria-log.com,https://preview.vercel.app
# You can set these in a repo-root `.env` for `docker compose` (see docker-compose.yml `trading-chart`) or here.

# FRONTEND_URL=http://localhost:3000
# STRIPE_REDIRECT_ALLOWED_ORIGINS=

# ── Deploy / CPU (docker-compose defaults SKIP_BINARY_BACKFILL_ON_STARTUP=true) ──
# NEVER set AUTH_ENABLED=false here for production — that exposes anonymous@local admin to everyone.
# Worker container sets AUTH_ENABLED=false in docker-compose.yml; API (trading-chart) must stay true.
# When true, restarting trading-chart does NOT scan every dataset and queue binary/tile rebuilds.
# Set false for a one-time full repair pass, or rebuild individual datasets from admin → Datasets → Rebuild binary.
# SKIP_BINARY_BACKFILL_ON_STARTUP=true
# BACKTEST_WHATIF_DRAIN_ON_API=false
# WEB_CONCURRENCY=2
# FIrstrate_SCHEDULE_TICK_SEC=120
