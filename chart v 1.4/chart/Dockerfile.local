# Trading Chart API — builds V9 React (TalariaV8bLive) inside the image so VPS deploys
# always ship fresh dist-v9 + cache-bumped index.html without manual local npm.
#
# Build from repository root (chart v 1.4/chart + homepage/.../dashboard/analytics/backend):
#   docker compose build trading-chart
# Optional stable cache-bust id:
#   docker compose build --build-arg GIT_COMMIT=$(git rev-parse --short HEAD) trading-chart

FROM node:20-alpine AS v9_react
WORKDIR /build
ARG GIT_COMMIT=
ENV BUILD_ID=${GIT_COMMIT}

COPY ["chart v 1.4/talaria-design/package.json", "chart v 1.4/talaria-design/package-lock.json", "./talaria-design/"]
COPY ["chart v 1.4/admin-design/package.json", "chart v 1.4/admin-design/package-lock.json", "./admin-design/"]
WORKDIR /build/talaria-design
# esbuild postinstall can hit ETXTBSY when npm runs lifecycle scripts in parallel (BuildKit).
ENV npm_config_foreground_scripts=true
RUN npm ci
WORKDIR /build/admin-design
RUN npm ci
WORKDIR /build
COPY ["chart v 1.4/talaria-design", "./talaria-design/"]
COPY ["chart v 1.4/admin-design", "./admin-design/"]
COPY ["chart v 1.4/chart", "./chart/"]
WORKDIR /build/talaria-design
ENV NODE_ENV=production
RUN npm run build:live:chart
WORKDIR /build/admin-design
RUN npm run build

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

COPY ["chart v 1.4/chart/requirements.txt", "./requirements.txt"]
RUN pip install --no-cache-dir -r requirements.txt

COPY ["chart v 1.4/chart/package.json", "chart v 1.4/chart/package-lock.json", "./"]
RUN npm ci

COPY ["chart v 1.4/chart", "./"]
# Colocated with api_server.py so imports work even if only /app is on PYTHONPATH.
COPY ["homepage/src/app/dashboard/analytics/backend", "./analytics_backend"]

RUN test -f ./analytics_backend/backtest_whatif.py \
    && test -d ./analytics_backend/analytics_core \
    && python3 -c "import _analytics_bootstrap; p=_analytics_bootstrap.install(); import analytics_core; print('analytics backend:', p)"

# Overwrite committed dist-v9 with freshly built + bump-dist-v9-cache output.
COPY --from=v9_react /build/chart/dist-v9 ./dist-v9
COPY --from=v9_react /build/chart/dist-admin ./dist-admin

# The legacy minified bundle (dist/) is ONLY a fallback for /chart/index.html when
# dist-v9 is absent (see api_server.py). dist-v9 is always built above and is the
# canonical served app, so skip the slow Terser minify (~7 min) by default.
# Set --build-arg BUILD_LEGACY_BUNDLE=1 if you ever need the legacy fallback bundle.
ARG BUILD_LEGACY_BUNDLE=0
RUN if [ "$BUILD_LEGACY_BUNDLE" = "1" ]; then \
        npm run build:chart-client; \
    else \
        echo "Skipping build:chart-client — dist-v9 is the canonical served app"; \
    fi

# Create runtime dirs. Do NOT `chmod -R /app`: recursing node_modules/site-packages
# added ~50s, and the copied files are already readable (container runs as root).
RUN mkdir -p uploads/bin uploads/tiles uploads/aggregates data db indicators

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=5 \
    CMD curl -f http://localhost:8000/api/status || exit 1

CMD ["gunicorn", "api_server:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "1800", \
     "--keep-alive", "5", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100"]
