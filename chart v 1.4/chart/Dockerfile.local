# Trading Chart API — builds V9 React (TalariaV8bLive) inside the image so VPS deploys
# always ship fresh dist-v9 + cache-bumped index.html without manual local npm.
#
# Build from repository root (chart v 1.4/chart + homepage/.../dashboard/analytics/backend):
#   docker compose build trading-chart
# Strict checkpoint build (ordinary local builds intentionally keep auto-increment):
#   CHECKPOINT_BUILD=1 CHART_BUILD_ID=YYYYMMDDbN SOURCE_COMMIT_SHA=<40hex> docker compose build trading-chart

ARG CHECKPOINT_BUILD=0
ARG CHART_BUILD_ID=
ARG SOURCE_COMMIT_SHA=

FROM node:20-alpine AS v9_react
WORKDIR /build
ARG CHECKPOINT_BUILD
ARG CHART_BUILD_ID
ARG SOURCE_COMMIT_SHA
ENV BUILD_ID=${CHART_BUILD_ID} \
    CHECKPOINT_BUILD=${CHECKPOINT_BUILD}

COPY ["chart v 1.4/talaria-design/package.json", "chart v 1.4/talaria-design/package-lock.json", "./talaria-design/"]
WORKDIR /build/talaria-design
# esbuild postinstall can hit ETXTBSY when npm runs lifecycle scripts in parallel (BuildKit).
ENV npm_config_foreground_scripts=true
RUN npm ci
WORKDIR /build
COPY ["scripts/checkpoint-build-assert.mjs", "./checkpoint-tools/checkpoint-build-assert.mjs"]
COPY ["scripts/lib/checkpoint-provenance.mjs", "./checkpoint-tools/lib/checkpoint-provenance.mjs"]
COPY ["scripts/lib/homepage-forwarding-contracts.mjs", "./checkpoint-tools/lib/homepage-forwarding-contracts.mjs"]
COPY ["scripts/lib/homepage-forwarding-contracts.mjs", "/scripts/lib/homepage-forwarding-contracts.mjs"]
# build:live:chart → preflight:module-contracts resolves ../../scripts from /build/talaria-design → /scripts/
COPY ["scripts/module-contract-preflight.mjs", "/scripts/module-contract-preflight.mjs"]
COPY ["scripts/module-contracts.json", "/scripts/module-contracts.json"]
# soak Fix-E named exemptions — soak at /build/chart/modules imports ../../../scripts/lib → /scripts/lib
COPY ["scripts/lib/m19-e-hotpath-console-exemptions.mjs", "/scripts/lib/m19-e-hotpath-console-exemptions.mjs"]
COPY ["chart v 1.4/talaria-design", "./talaria-design/"]
COPY ["chart v 1.4/chart", "./chart/"]
COPY ["homepage/public/chart/modules/m20-q6-replay-lifecycle-binding.test.mjs", "/homepage/public/chart/modules/m20-q6-replay-lifecycle-binding.test.mjs"]
# module-contract-preflight is COPY'd to /scripts (repoRoot would be /). Point it at
# a reconstructed tree that matches contract inventory/mirror paths.
COPY ["homepage/public/chart/modules/module-presence-runtime.js", "/contract-root/homepage/public/chart/modules/module-presence-runtime.js"]
COPY ["homepage/public/chart/modules/indicator-performance.js", "/contract-root/homepage/public/chart/modules/indicator-performance.js"]
COPY ["homepage/public/chart/dist-v9", "/contract-root/homepage/public/chart/dist-v9"]
COPY ["homepage/public/chart/multichart-prod", "/contract-root/homepage/public/chart/multichart-prod"]
# Public mirror of routed /chart/multichart/ panel shell — required by
# module-contracts.json rows multichart-panel-shell-{source,public}.
COPY ["homepage/public/chart/multichart/chart-host.html", "/contract-root/homepage/public/chart/multichart/chart-host.html"]
RUN mkdir -p "/contract-root/chart v 1.4" \
  && ln -sfn /build/chart "/contract-root/chart v 1.4/chart" \
  && ln -sfn /build/talaria-design "/contract-root/chart v 1.4/talaria-design" \
  # chart/dist-v9 is .dockerignored (rebuilt by vite); seed from committed public mirror
  # so module-contract-preflight's chart-host inventory exists before build:live:chart.
  && rm -rf /build/chart/dist-v9 \
  && cp -a /contract-root/homepage/public/chart/dist-v9 /build/chart/dist-v9
ENV TALARIA_MODULE_CONTRACT_ROOT=/contract-root
WORKDIR /build/talaria-design
ENV NODE_ENV=production
RUN if [ "$CHECKPOINT_BUILD" = "1" ]; then \
      node /build/checkpoint-tools/checkpoint-build-assert.mjs inputs \
        --strict="$CHECKPOINT_BUILD" \
        --build-id="$CHART_BUILD_ID" \
        --source-sha="$SOURCE_COMMIT_SHA"; \
    elif [ -n "$CHART_BUILD_ID" ]; then \
      echo "CHART_BUILD_ID requires CHECKPOINT_BUILD=1" >&2; exit 1; \
    fi \
    && if [ "$CHECKPOINT_BUILD" = "1" ]; then \
      node /build/chart/modules/m19-progressive-session-soak.test.mjs; \
    fi \
    && if [ "$CHECKPOINT_BUILD" = "1" ]; then \
      BUILD_ID="$CHART_BUILD_ID" node /build/chart/scripts/bump-chart-engine-build.mjs; \
    fi \
    && npm run build:live:chart \
    && if [ "$CHECKPOINT_BUILD" = "1" ]; then \
      node /build/checkpoint-tools/checkpoint-build-assert.mjs layout \
        --build-id="$CHART_BUILD_ID" \
        --source-sha="$SOURCE_COMMIT_SHA" \
        --chart-root=/build/chart \
        --live-root=/build/talaria-design/live \
        --homepage-chart-root=/homepage/public/chart; \
    fi

FROM python:3.11-slim

ARG CHECKPOINT_BUILD
ARG CHART_BUILD_ID
ARG SOURCE_COMMIT_SHA
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT_SHA}" \
      io.talaria.checkpoint.build-id="${CHART_BUILD_ID}" \
      io.talaria.checkpoint.strict="${CHECKPOINT_BUILD}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

COPY ["chart v 1.4/chart/requirements.txt", "./requirements.txt"]
RUN pip install --no-cache-dir -r requirements.txt

COPY ["securty/python", "/opt/talaria_security_lib"]
ENV PYTHONPATH=/opt/talaria_security_lib

COPY ["chart v 1.4/chart/package.json", "chart v 1.4/chart/package-lock.json", "./"]
RUN npm ci

COPY ["chart v 1.4/chart", "./"]
COPY ["shared/entitlements.json", "./shared/entitlements.json"]
# Colocated with api_server.py so imports work even if only /app is on PYTHONPATH.
COPY ["homepage/src/app/dashboard/analytics/backend", "./analytics_backend"]

RUN test -f ./analytics_backend/backtest_whatif.py \
    && test -d ./analytics_backend/analytics_core \
    && python3 -c "import _analytics_bootstrap; p=_analytics_bootstrap.install(); import analytics_core; print('analytics backend:', p)"

# Overwrite committed dist-v9 with freshly built + bump-dist-v9-cache output.
COPY --from=v9_react /build/chart/dist-v9 ./dist-v9
# index.html references /chart/modules/* and /chart/chart.js — must match the
# same build as dist-v9 (stale modules caused "updateSLTPLines" log spam on VPS).
COPY --from=v9_react /build/chart/modules ./modules
COPY --from=v9_react /build/chart/chart.js ./chart.js
COPY --from=v9_react /build/chart/multichart-prod ./multichart-prod
COPY --from=v9_react /build/chart/workers ./workers
COPY --from=v9_react /build/chart/vendor ./vendor
COPY --from=v9_react /build/chart/fonts ./fonts
COPY --from=v9_react /build/chart/sw.js ./sw.js

# The legacy minified bundle (dist/) is ONLY a fallback for /chart/index.html when
# dist-v9 is absent (see api_server.py). dist-v9 is always built above and is the
# canonical served app, so skip the slow Terser minify (~7 min) by default.
# Set --build-arg BUILD_LEGACY_BUNDLE=1 if you ever need the legacy fallback bundle.
ARG BUILD_LEGACY_BUNDLE=0
RUN if [ "$BUILD_LEGACY_BUNDLE" = "1" ]; then \
        npm run build:chart-client; \
    else \
        echo "Skipping build:chart-client — dist-v9 is the canonical served app"; \
    fi

# Create runtime dirs. Chart writes heavily to uploads/data volumes — keep root at runtime
# so existing Docker volumes (root-owned from prior deploys) stay writable.
RUN mkdir -p uploads/bin uploads/tiles uploads/aggregates data db indicators

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=5 \
    CMD curl -f http://localhost:8000/api/status || exit 1

CMD ["gunicorn", "api_server:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "1800", \
     "--keep-alive", "5", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100"]
