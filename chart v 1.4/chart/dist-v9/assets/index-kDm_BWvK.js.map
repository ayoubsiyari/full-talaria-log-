          style={{ width: 32, height: 36, flexShrink: 0, cursor: "default", display: "flex", alignItems: "center", justifyContent: "center", marginLeft: -10, overflow: "visible" }}>
          <img src="/LOGO-07.png" alt="Talaria"
            style={{ width: 32, height: 32, objectFit: "contain", display: "block",
              transform: logoActive ? "scale(1.12)" : hov==="logo-btn" ? "scale(1.05)" : "scale(1)",
