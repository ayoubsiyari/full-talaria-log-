                    {/* Line row */}
                    <span style={{fontSize:12,color:c.ts,padding:"8px 0"}}>Line</span>
                    <div style={{padding:"8px 0"}}>{colorSwatch("tlLineColor",tlStyle.lineColor)}</div>
                    <div style={{padding:"8px 0",position:"relative"}}>
