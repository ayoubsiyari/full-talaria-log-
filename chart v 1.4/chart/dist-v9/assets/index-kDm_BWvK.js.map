                                  <input type="text" placeholder={`e.g. ${(127).toFixed(decimals)}`} value={gotoNewPrice}
                                    onChange={e=>{e.stopPropagation();const v=e.target.value;if(v===""||/^-?\d*\.?\d*$/.test(v))setGotoNewPrice(v);}}
                                    onBlur={e=>{const v=parseFloat(gotoNewPrice);if(!isNaN(v))setGotoNewPrice(v.toFixed(decimals));}}
