                                  <div style={{display:"flex",alignItems:"center",background:c.well,border:`1px solid ${gotoTimeOpen?c.acL:c.brH}`,transition:"border-color 0.12s"}}>
                                    <input value={gotoTimeInput}
                                      onChange={e=>{setGotoTimeInput(e.target.value);applyTime(e.target.value);}}
                                      onBlur={()=>{const h=parseInt(gotoNewTime.split(":")[0])||0;const m=parseInt(gotoNewTime.split(":")[1])||0;setGotoTimeInput(fmtTime(h,m));}}
                                      onClick={e=>e.stopPropagation()}
                                      style={inSx}/>
                                    <div onClick={e=>{e.stopPropagation();if(gotoTimeOpen){setGotoTimeOpen(false);}else{const r=e.currentTarget.parentElement.getBoundingClientRect();const tmW=140,tmH=180;const rawL=r.left/Z,rawT=r.bottom/Z+6;setGotoTimePos({top:Math.min(rawT,window.innerHeight/Z-tmH-8),left:Math.max(8,Math.min(rawL,window.innerWidth/Z-tmW-8))});setGotoTimeOpen(true);setGotoCalOpen(false);}}} style={chevSx}>
