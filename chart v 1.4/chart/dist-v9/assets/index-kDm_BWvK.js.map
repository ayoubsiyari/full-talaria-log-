                      <div key={key} style={{display:"flex",alignItems:"center"}}>
                        {TlChk(rrStyle[key], `rrchk-${key}`, label, ()=>setRrStyle(s=>({...s,[key]:!s[key]})))}
                      </div>
                    ))}
                  </div>
                </>);
                /* ── Range Tool specific style tab ── */
                if (tlSubTool.icon === "measure") return (<>
                  <div style={{display:"grid",gridTemplateColumns:"1fr auto auto auto",columnGap:8,alignItems:"center"}}>
                    {/* Column headers */}
                    <div/><div/>
                    <div style={{display:"flex",flexDirection:"column",alignItems:"center",paddingBottom:4}}>
                      <span style={{fontSize:9,fontWeight:800,color:c.tm,letterSpacing:"0.08em"}}>STYLE</span>
                    </div>
                    <div style={{display:"flex",flexDirection:"column",alignItems:"center",paddingBottom:4}}>
                      <span style={{fontSize:9,fontWeight:800,color:c.tm,letterSpacing:"0.08em"}}>THICKNESS</span>
