                  onPointerDown={e=>e.stopPropagation()} onClick={e=>e.stopPropagation()}
                  style={{minWidth:60,maxWidth:200,fontSize:14,fontWeight:700,color:c.tx,marginLeft:8,background:"transparent",border:"none",outline:"none",fontFamily:F,padding:"0 2px",cursor:"text"}}/>
              : <span onClick={e=>{e.stopPropagation();setTxtNameEditing(true);}}
                  style={{fontSize:14,fontWeight:700,color:c.tx,marginLeft:8,cursor:"text",lineHeight:"1.4"}}>{txtName}</span>
            }
