                      {item.icon(hov===`txtmore-${item.lbl}`?c.tx:c.ts)}
                      <span style={{fontSize:12,color:hov===`txtmore-${item.lbl}`?c.tx:c.ts,fontWeight:500}}>{item.lbl}</span>
