                  btmTab==="open"?r.status==="open":
                  btmTab==="history"?r.status==="closed":false
                );
                const cols="minmax(0,0.7fr) minmax(0,0.9fr) minmax(0,1.1fr) minmax(0,0.9fr) minmax(0,1fr) minmax(0,0.6fr) minmax(0,0.9fr) minmax(0,1fr) minmax(0,1fr) minmax(0,1fr) minmax(0,1.1fr) minmax(0,1.2fr) minmax(0,1fr) minmax(0,0.9fr) minmax(0,1fr)";
                if(btmTab==="analytics") return(
                  <div className="tlr-scroll" style={{flex:1,overflowY:"auto",minHeight:0,padding:"14px 16px",display:"flex",flexDirection:"column",gap:14}}>
                    {/* Summary cards */}
                    <div style={{display:"grid",gridTemplateColumns:"repeat(6,1fr)",gap:8}}>
                      {[{l:"Total Trades",v:"14",sub:null},{l:"Win Rate",v:"64.3%",sub:null,col:c.gn},{l:"Profit Factor",v:"1.84",sub:null,col:c.gn},{l:"Net P&L",v:"+$1,533",sub:null,col:c.gn},{l:"Avg Win",v:"+$316",sub:null,col:c.gn},{l:"Avg Loss",v:"-$267",sub:null,col:c.rd}].map(({l,v,col},i)=>(
                        <div key={i} style={{background:c.bg,border:`1px solid ${c.br}`,padding:"10px 12px",display:"flex",flexDirection:"column",gap:5}}>
                          <span style={{fontSize:9,fontWeight:700,color:c.tm,letterSpacing:"0.07em"}}>{l}</span>
                          <span style={{fontSize:18,fontWeight:700,color:col||c.tx,fontVariantNumeric:"tabular-nums"}}>{v}</span>
                        </div>
                      ))}
                    </div>
                    {/* Win/Loss breakdown + pair breakdown */}
                    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8}}>
                      {/* Win/Loss bar */}
                      <div style={{background:c.bg,border:`1px solid ${c.br}`,padding:"12px 14px"}}>
                        <div style={{fontSize:9,fontWeight:700,color:c.tm,letterSpacing:"0.07em",marginBottom:10}}>WIN / LOSS BREAKDOWN</div>
                        {[{l:"Wins",n:9,tot:14,col:c.gn},{l:"Losses",n:5,tot:14,col:c.rd}].map(({l,n,tot,col})=>(
                          <div key={l} style={{marginBottom:8}}>
                            <div style={{display:"flex",justifyContent:"space-between",marginBottom:3}}>
                              <span style={{fontSize:10,fontWeight:600,color:c.ts}}>{l}</span>
                              <span style={{fontSize:10,fontWeight:700,color:col,fontVariantNumeric:"tabular-nums"}}>{n} <span style={{color:c.tm,fontWeight:500}}>/ {tot}</span></span>
                            </div>
                            <div style={{height:5,background:"rgba(140,160,255,0.07)",borderRadius:0,overflow:"hidden"}}>
                              <div style={{width:`${(n/tot)*100}%`,height:"100%",background:col,opacity:0.75}}/>
                            </div>
                          </div>
                        ))}
                        <div style={{height:1,background:c.br,margin:"10px 0"}}/>
                        {[{l:"Best Trade",v:"+$1,090",sym:"EUR/JPY",col:c.gn},{l:"Worst Trade",v:"-$500",sym:"EUR/USD",col:c.rd}].map(({l,v,sym,col})=>(
                          <div key={l} style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:5}}>
                            <span style={{fontSize:10,color:c.tm}}>{l}</span>
                            <div style={{display:"flex",alignItems:"center",gap:6}}>
                              <span style={{fontSize:10,color:c.ts}}>{sym}</span>
                              <span style={{fontSize:11,fontWeight:700,color:col,fontVariantNumeric:"tabular-nums"}}>{v}</span>
                            </div>
                          </div>
                        ))}
                      </div>
                      {/* Pair breakdown */}
                      <div style={{background:c.bg,border:`1px solid ${c.br}`,padding:"12px 14px"}}>
                        <div style={{fontSize:9,fontWeight:700,color:c.tm,letterSpacing:"0.07em",marginBottom:10}}>TRADES BY PAIR</div>
                        {[{sym:"EUR/JPY",n:2,pnl:"+$827",col:c.gn},{sym:"GBP/USD",n:2,pnl:"+$415",col:c.gn},{sym:"USD/JPY",n:1,pnl:"-$263",col:c.rd},{sym:"AUD/USD",n:1,pnl:"+$96",col:c.gn},{sym:"NZD/USD",n:1,pnl:"+$140",col:c.gn},{sym:"GBP/JPY",n:1,pnl:"+$420",col:c.gn},{sym:"Others",n:6,pnl:"-$102",col:c.rd}].map(({sym,n,pnl,col})=>(
                          <div key={sym} style={{display:"flex",alignItems:"center",gap:8,marginBottom:5}}>
                            <span style={{fontSize:10,fontWeight:600,color:c.ts,width:60,flexShrink:0}}>{sym}</span>
                            <div style={{flex:1,height:4,background:"rgba(140,160,255,0.07)"}}>
                              <div style={{width:`${Math.min((n/4)*100,100)}%`,height:"100%",background:col,opacity:0.6}}/>
                            </div>
                            <span style={{fontSize:10,color:c.tm,width:16,textAlign:"center",flexShrink:0}}>{n}</span>
                            <span style={{fontSize:10,fontWeight:700,color:col,fontVariantNumeric:"tabular-nums",width:52,textAlign:"right",flexShrink:0}}>{pnl}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                    {/* Cumulative P&L bar chart */}
                    <div style={{background:c.bg,border:`1px solid ${c.br}`,padding:"12px 14px"}}>
                      <div style={{fontSize:9,fontWeight:700,color:c.tm,letterSpacing:"0.07em",marginBottom:10}}>CUMULATIVE P&L</div>
                      <div style={{display:"flex",alignItems:"flex-end",gap:3,height:52}}>
                        {[120,260,110,350,240,590,490,910,610,1090,990,1330,1225,1533].map((v,i)=>{
                          const prev=i>0?[120,260,110,350,240,590,490,910,610,1090,990,1330,1225,1533][i-1]:0;
                          const gain=v>prev;
                          const pct=Math.abs(v)/1533;
                          return <div key={i} style={{flex:1,display:"flex",flexDirection:"column",alignItems:"center",gap:2}}>
                            <div style={{width:"100%",height:`${Math.max(pct*48,3)}px`,background:gain?c.gn:c.rd,opacity:0.7,marginTop:"auto"}}/>
                            <span style={{fontSize:8,color:c.tm,fontVariantNumeric:"tabular-nums"}}>{i+1}</span>
                          </div>;
                        })}
                      </div>
                    </div>
                    {/* Tag performance */}
                    <div style={{background:c.bg,border:`1px solid ${c.br}`,padding:"12px 14px"}}>
                      <div style={{fontSize:9,fontWeight:700,color:c.tm,letterSpacing:"0.07em",marginBottom:8}}>TAG PERFORMANCE</div>
                      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:6}}>
                        {[{tag:"scalp",trades:5,wr:"80%",pnl:"+$727"},{tag:"swing",trades:4,wr:"50%",pnl:"+$667"},{tag:"trend",trades:3,wr:"100%",pnl:"+$853"},{tag:"news",trades:2,wr:"0%",pnl:"-$605"}].map(({tag,trades,wr,pnl})=>{
                          const pos=!pnl.startsWith("-");
                          return <div key={tag} style={{background:"rgba(140,160,255,0.04)",border:`1px solid ${c.br}`,padding:"8px 10px"}}>
                            <div style={{fontSize:9,fontWeight:700,color:c.acL,letterSpacing:"0.05em",marginBottom:5}}>{tag.toUpperCase()}</div>
                            <div style={{fontSize:10,color:c.tm,marginBottom:2}}>{trades} trades · WR {wr}</div>
                            <div style={{fontSize:12,fontWeight:700,color:pos?c.gn:c.rd,fontVariantNumeric:"tabular-nums"}}>{pnl}</div>
                          </div>;
                        })}
                      </div>
                    </div>
                  </div>
                );
                const hdrs=[
                  {label:"ID",       key:"id",     sortable:true},
                  {label:"TIME",     key:"time",   sortable:true},
                  {label:"SYMBOL",   key:"sym",    sortable:true},
                  {label:"SIDE",     key:"side",   sortable:true},
                  {label:"STATUS",   key:"status", sortable:true},
                  {label:"SIZE",     key:"sz",     sortable:true},
                  {label:"TYPE",     key:"type",   sortable:true},
                  {label:"ENTRY",    key:null,     sortable:false},
                  {label:"EXIT",     key:null,     sortable:false},
                  {label:"P&L",      key:"pnl",    sortable:true},
                  {label:"DURATION", key:"dur",    sortable:true},
                  {label:"TAGS",     key:null,     sortable:false},
                  {label:"NOTES",        key:null,     sortable:false},
                  {label:"SCREENSHOTS",  key:null,     sortable:false},
                  {label:"ACTION",       key:null,     sortable:false},
                ];
                const getSortVal=(r,key)=>{
                  if(key==="id")     return parseInt(r.id.replace(/\D/g,""));
                  if(key==="time"){ const mo={Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11}; const p=(r.time||"").split(" "); const [h,m]=(p[2]||"00:00").split(":").map(Number); return ((mo[p[0]]||0)*31+parseInt(p[1]||0))*1440+h*60+m; }
                  if(key==="sym")    return r.sym;
                  if(key==="side")   return r.side;
                  if(key==="status") return r.status;
                  if(key==="sz")     return parseFloat(r.sz)||0;
                  if(key==="type")   return r.type;
                  if(key==="pnl"){   if(r.pnl==="—")return -Infinity; return parseFloat(r.pnl.replace(/[$,+]/g,""))||0; }
                  if(key==="dur"){   if(r.dur==="—")return -1; const m=r.dur.match(/(\d+)h\s*(\d+)m/); return m?parseInt(m[1])*60+parseInt(m[2]):0; }
                  return "";
                };
                const displayRows=tblSort
                  ?[...filtered].sort((a,b)=>{const va=getSortVal(a,tblSort.col),vb=getSortVal(b,tblSort.col);if(typeof va==="string")return tblSort.dir==="asc"?va.localeCompare(vb):vb.localeCompare(va);return tblSort.dir==="asc"?va-vb:vb-va;})
                  :[...filtered].reverse();
                return(
                <div className="tlr-scroll" style={{flex:1,overflowY:btmOpen?"auto":"hidden",minHeight:0}}>
                  <div style={{display:"grid",gridTemplateColumns:cols,columnGap:6,fontSize:9,fontWeight:700,letterSpacing:"0.08em",color:c.tm,padding:"4px 10px 3px",borderBottom:`1px solid ${c.br}`,position:"sticky",top:0,background:c.sf,zIndex:1}}>
                    {hdrs.map(({label,key,sortable})=>{
                      const isAct=tblSort&&tblSort.col===key;
                      const hk=`hdr-${key}`;
                      return(
                        <div key={label}
                          onClick={sortable?()=>setTblSort(p=>!p||p.col!==key?{col:key,dir:"desc"}:p.dir==="desc"?{col:key,dir:"asc"}:null):undefined}
                          onMouseEnter={sortable?()=>setHov(hk):undefined}
                          onMouseLeave={sortable?()=>setHov(null):undefined}
                          style={{display:"flex",alignItems:"center",gap:3,overflow:"hidden",whiteSpace:"nowrap",cursor:"default",userSelect:"none",color:isAct?c.acL:hov===hk?c.tx:c.tm,transition:"color 0.15s"}}>
                          <span style={{overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{label}</span>
                          {sortable&&(
                            <svg width={7} height={5} viewBox="0 0 7 5" fill="none" style={{flexShrink:0,transform:isAct&&tblSort.dir==="asc"?"rotate(180deg)":"rotate(0deg)",transition:"transform 0.15s ease",opacity:isAct?1:0.35}}>
                              <path d="M1,1.5 L3.5,4 L6,1.5" stroke={isAct?c.acL:c.tm} strokeWidth={1.4} strokeLinecap="round" strokeLinejoin="round"/>
                            </svg>
                          )}
                        </div>
                      );
                    })}
                  </div>
                  {displayRows.map((r,i)=>{
                    const isSelected=selRow===r.id;
                    const isHov=hov===`pos-${i}`;
                    const rowBg=isSelected?"rgba(140,160,255,0.07)":isHov?"rgba(140,160,255,0.025)":"transparent";
                    const openCard=()=>{setTradeCard(r);setTradeCardPreTags([...r.preTags]);setTradeCardPostTags([...r.postTags]);setTradeCardNotes(tradeNotes[r.id]||"");};
                    const isActive=r.status==="open"||r.status==="pending";
                    return(
                    <div key={r.id}
                      onClick={()=>setSelRow(v=>v===r.id?null:r.id)}
                      onDoubleClick={e=>{e.stopPropagation();openCard();}}
                      onMouseEnter={()=>setHov(`pos-${i}`)} onMouseLeave={()=>setHov(null)}
                      style={{display:"grid",gridTemplateColumns:cols,columnGap:6,fontSize:10,fontWeight:500,padding:"5px 10px",alignItems:"center",fontVariantNumeric:"tabular-nums",borderBottom:`1px solid ${c.br}`,background:rowBg,transition:"background 0.1s",cursor:"default",userSelect:"none",position:"relative"}}>
                      {isSelected&&<div style={{position:"absolute",left:0,top:0,bottom:0,width:2,background:c.acL}}/>}
                      <div onMouseEnter={()=>setHov(`id-${i}`)} onMouseLeave={()=>setHov(null)}
                        style={{overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>
                        <span onClick={e=>{e.stopPropagation();openCard();}}
                          style={{position:"relative",display:"inline-flex",fontSize:10,fontWeight:700,cursor:"pointer",letterSpacing:"0.02em",userSelect:"none",
                            color:isActive?(hov===`id-${i}`?"rgba(0,212,161,1)":undefined):hov===`id-${i}`?c.acL:c.ts,
                            animation:isActive&&hov!==`id-${i}`?"tlrIdPulse 2s ease-in-out infinite":undefined,
                            transition:isActive?"none":"color 0.15s",
                            background:hov===`id-${i}`?c.hv:"transparent",
                            padding:"2px 4px"}}>
                          {r.id}
                          {hov===`id-${i}`&&<div style={{position:"absolute",bottom:0,left:"50%",transform:"translateX(-50%)",width:"80%",height:1,background:`linear-gradient(90deg,transparent,${isActive?c.gn:c.acL},transparent)`,pointerEvents:"none"}}/>}
                        </span>
                      </div>
                      <div style={{display:"flex",flexDirection:"column",gap:1,overflow:"hidden"}}>
                        <span style={{fontSize:9,color:c.tm,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.time.split(" ").slice(0,2).join(" ")}</span>
                        <span style={{fontSize:10,color:c.ts,fontVariantNumeric:"tabular-nums",overflow:"hidden",whiteSpace:"nowrap"}}>{r.time.split(" ")[2]}</span>
                      </div>
                      <span style={{fontWeight:600,color:c.tx,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.sym}</span>
                      <span style={{fontWeight:600,color:r.side==="LONG"?c.gn:c.rd,overflow:"hidden",whiteSpace:"nowrap"}}>{r.side==="LONG"?"Long":"Short"}</span>
                      {(()=>{const sc={open:{col:c.gn},pending:{col:"#FF8C42"},closed:{col:c.tm}};const s=sc[r.status]||sc.closed;return<span style={{fontSize:9,fontWeight:700,letterSpacing:"0.05em",color:s.col,textTransform:"uppercase",overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.status}</span>;})()}
                      <span style={{color:c.ts,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.sz}</span>
                      <span style={{color:c.ts,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.type}</span>
                      <span style={{color:c.ts,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.entry}</span>
                      <span style={{color:r.pnl==="—"?c.tm:c.tx,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.exit}</span>
                      <span style={{color:r.pc,fontWeight:700,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.pnl}</span>
                      <span style={{color:r.dur==="—"?c.tm:c.ts,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis"}}>{r.dur}</span>
                      {/* Tags cell — Pre and Post side by side */}
                      <div style={{display:"flex",flexDirection:"row",alignItems:"center",gap:6,overflow:"visible",minWidth:0}} onClick={e=>e.stopPropagation()}>
                        {(()=>{
                          const tagCfgs = [
                            {type:"pre",  tags:r.preTags,  activeCol:"#FF8C42",               acGlow:"rgba(255,140,66,0.45)",  topGrad:"linear-gradient(90deg,rgba(255,140,66,0.5),#FF8C42,rgba(255,140,66,0.5))",  label:"PRE",  canEdit: r.status==="pending"||r.status==="open"},
                            {type:"post", tags:r.postTags, activeCol:"rgba(180,140,255,0.95)", acGlow:"rgba(180,140,255,0.4)", topGrad:"linear-gradient(90deg,rgba(180,140,255,0.5),rgba(180,140,255,0.95),rgba(180,140,255,0.5))", label:"POST", canEdit: r.status==="closed"},
                          ];
                          return tagCfgs.map(({type,tags,label,activeCol,acGlow,topGrad,canEdit})=>{
                            const hk=`tag-${r.id}-${type}`;
                            const isOpen=tagDrop&&tagDrop.id===r.id&&tagDrop.type===type;
                            const hasTags=tags.length>0;
                            const isHov=hov===hk;
                            const clickable = hasTags||canEdit;
                            const col = isOpen?activeCol : isHov&&clickable?activeCol : hasTags?"rgba(255,255,255,0.35)" : "rgba(255,255,255,0.14)";
                            return(
                              <div key={type} style={{position:"relative"}}>
                                <div onMouseEnter={()=>clickable&&setHov(hk)} onMouseLeave={()=>setHov(null)}
                                  onClick={e=>{e.stopPropagation();if(clickable){if(isOpen){setTagDrop(null);}else{const rect=e.currentTarget.getBoundingClientRect();const dw=220;const left=Math.max(8,Math.min(rect.left,window.innerWidth-dw-8));setTagDropPos({top:rect.bottom+4,left});setTagDrop({id:r.id,type});setTagEditInput("");}}}}
                                  style={{position:"relative",display:"inline-flex",alignItems:"center",gap:3,cursor:"default",userSelect:"none",paddingBottom:2}}>
                                  <span style={{fontSize:8,fontWeight:700,letterSpacing:"0.06em",color:col,lineHeight:1,transition:"color 0.15s"}}>{label}</span>
                                  {clickable&&<svg width={5} height={3} viewBox="0 0 5 3" style={{flexShrink:0,transition:"transform 0.15s",transform:isOpen?"rotate(180deg)":"rotate(0deg)"}}><path d="M0.5,0.5 L2.5,2.5 L4.5,0.5" stroke={col} strokeWidth={1.3} fill="none" strokeLinecap="round" strokeLinejoin="round"/></svg>}
                                  {isOpen&&<div style={{position:"absolute",bottom:0,left:0,right:0,height:2,background:`linear-gradient(90deg,transparent,${activeCol},transparent)`,boxShadow:`0 0 5px ${acGlow}`,pointerEvents:"none"}}/>}
                                  {isHov&&!isOpen&&clickable&&<div style={{position:"absolute",bottom:0,left:0,right:0,height:1,background:"linear-gradient(90deg,transparent,rgba(255,255,255,0.18),transparent)",pointerEvents:"none"}}/>}
                                </div>
                                {isOpen&&(()=>{
                                  const editTags = type==="pre" ? r.preTags : r.postTags;
                                  const updTags = type==="pre" ? updPreTags : updPostTags;
                                  const defs = type==="pre" ? tagDefs : postTagDefs;
                                  const accentCol = activeCol;
                                  const accentBorder = type==="pre" ? "rgba(255,140,66,0.4)" : "rgba(180,140,255,0.4)";
                                  const accentBg = type==="pre" ? "rgba(255,140,66,0.1)" : "rgba(180,140,255,0.1)";
                                  return(
                                  <div data-sdrop="1" onClick={e=>e.stopPropagation()} style={{position:"fixed",top:tagDropPos.top,left:tagDropPos.left,zIndex:9500,width:220,background:c.sf,border:`1px solid ${type==="pre"?"rgba(255,140,66,0.25)":"rgba(180,140,255,0.25)"}`,boxShadow:"0 4px 20px rgba(0,0,0,0.55)",fontFamily:F,animation:"tlrDropIn 0.15s ease"}}>
                                    <div style={{height:2,background:topGrad}}/>
                                    <div style={{padding:"8px 10px",display:"flex",flexDirection:"column",gap:8}}>
                                      {defs.map(def=>{
                                        if(def.type==="bool"){
                                          const active=editTags.includes(def.label);
                                          return(
                                            <div key={def.id} style={{display:"flex",alignItems:"center",justifyContent:"space-between",gap:8}}>
                                              <span style={{fontSize:10,color:c.ts,fontWeight:500}}>{def.label}</span>
                                              <div style={{display:"flex",gap:2,flexShrink:0}}>
                                                {[["YES",true],["NO",false]].map(([lbl,val])=>{
                                                  const sel=val?active:!active;
                                                  const isH2=swHov===`td-yn-${r.id}-${def.id}-${lbl}`;
                                                  return(
                                                    <div key={lbl}
                                                      onClick={()=>updTags(r.id,val?[...editTags.filter(x=>x!==def.label),def.label]:editTags.filter(x=>x!==def.label))}
                                                      onMouseEnter={()=>setSwHov(`td-yn-${r.id}-${def.id}-${lbl}`)} onMouseLeave={()=>setSwHov(null)}
                                                      style={{padding:"1px 7px",fontSize:9,fontWeight:sel?700:500,cursor:"default",transition:"all 0.12s",
                                                        color:sel?accentCol:isH2?"rgba(255,255,255,0.65)":c.ts,
                                                        background:sel?accentBg:"transparent",
                                                        border:`1px solid ${sel?accentBorder:"rgba(255,255,255,0.08)"}`}}>
                                                      {lbl}
                                                    </div>
                                                  );
                                                })}
                                              </div>
                                            </div>
                                          );
                                        } else {
                                          return(
                                            <div key={def.id}>
                                              <span style={{fontSize:8,fontWeight:700,color:c.tm,letterSpacing:"0.07em",display:"block",marginBottom:4}}>{def.label.toUpperCase()}</span>
                                              <div style={{display:"flex",flexWrap:"wrap",gap:3}}>
                                                {def.options.map(opt=>{
                                                  const active=editTags.includes(opt);
                                                  const isH=swHov===`td-opt-${r.id}-${def.id}-${opt}`;
                                                  return(
                                                    <div key={opt} onClick={()=>updTags(r.id,active?editTags.filter(x=>x!==opt):[...editTags,opt])}
                                                      onMouseEnter={()=>setSwHov(`td-opt-${r.id}-${def.id}-${opt}`)} onMouseLeave={()=>setSwHov(null)}
                                                      style={{padding:"2px 8px",fontSize:9,fontWeight:active?700:400,cursor:"default",transition:"all 0.12s",
                                                        color:active?accentCol:isH?"rgba(255,255,255,0.55)":c.ts,
                                                        background:active?accentBg:"transparent",
                                                        border:`1px solid ${active?accentBorder:"rgba(255,255,255,0.07)"}`}}>
                                                      {opt}
                                                    </div>
                                                  );
                                                })}
                                              </div>
                                            </div>
                                          );
                                        }
                                      })}
                                    </div>
                                  </div>
                                  );
                                })()}
                              </div>
                            );
                          });
                        })()}
                      </div>
                      {/* Notes cell */}
                      <div style={{overflow:"hidden",minWidth:0}} onClick={e=>e.stopPropagation()}>
                        {tradeNotes[r.id] ? (
                          <span style={{fontSize:9,color:c.ts,overflow:"hidden",whiteSpace:"nowrap",textOverflow:"ellipsis",display:"block"}}
                            title={tradeNotes[r.id]}>{tradeNotes[r.id]}</span>
                        ) : (
                          <span style={{fontSize:9,color:c.tm,fontStyle:"italic"}}>—</span>
                        )}
                      </div>
                      {/* Screenshots cell */}
                      <div style={{overflow:"hidden",minWidth:0}} onClick={e=>e.stopPropagation()}>
